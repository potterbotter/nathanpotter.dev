// Cloudflare Workers config. `wrangler deploy` runs the build (content/cv.json → dist/),
// serves dist/ as static assets, and runs src/worker.js only for /admin/* and /api/*.
{
  "name": "nathanpotter-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node build/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nathanpotter-dev",
      "database_id": "a7a93cf1-0cf5-49f0-99b1-5a02180a6e45",
      "migrations_dir": "migrations"
    }
  ],
  // /admin/* and /api/admin/* are handled by a separate, private admin Worker that has no public route of its own.
  "services": [
    { "binding": "ADMIN", "service": "nathanpotter-dev-admin" }
  ],
  // Not secret. ACCESS_* come from the Cloudflare Access application (Zero Trust dashboard); the job-fit tool uses
  // them to recognize Nathan's own signed-in runs.
  // Secrets (set in the dashboard, never here): ANTHROPIC_API_KEY, ADMIN_EMAIL, TURNSTILE_SECRET, ALERT_EMAIL (optional).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "nathanjpotter.cloudflareaccess.com",
    "ACCESS_AUD": "c227797505b47d742fb88d360c2d0d8dc1b5503f16f0291f9fe4890e10aced91",
    // Job-fit tool: kill switch, model and limits (DESIGN.md, "Job-fit tool").
    "JOBFIT_ENABLED": "true",
    "JOBFIT_MODEL": "claude-opus-5-5",
    "JOBFIT_MONTHLY_BUDGET_USD": "4",
    "JOBFIT_EFFORT": "medium",
    "JOBFIT_DAILY_CAP": "20", // about $1.50 a day at ~7¢ a run, so one bad day cannot use the whole monthly budget
    "JOBFIT_PER_IP_DAILY": "5"
  },
  // Burst limit for the job-fit tool: 3 requests per minute per IP (counted by Cloudflare, never stored).
  "ratelimits": [
    { "name": "JOBFIT_BURST", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "JOBFIT_FETCH", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Analytics beacons: 60 per minute per IP is far above a real visitor and well below a script.
    { "name": "COLLECT_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  // Budget alert emails, sent from alerts@nathanpotter.dev to a verified Email Routing address.
  "send_email": [
    { "name": "ALERTS" }
  ],
  // Daily analytics retention cleanup (03:17 Pacific during PDT). The other two are the private admin Worker's daily
  // jobs, handed to it over the ADMIN binding (03:27 and 08:00 Pacific during PDT); its 5-minute work runs on its own
  // timer, since cron triggers that run several times an hour don't fire on this account.
  "triggers": { "crons": ["17 10 * * *", "27 10 * * *", "0 15 * * *"] },
  "observability": { "enabled": true }
}
