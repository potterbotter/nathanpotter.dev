// Cloudflare Workers config. `wrangler deploy` runs the build (content/cv.json → dist/),
// then serves dist/ as static assets. No Worker script yet; server code will add "main".
{
  "name": "nathanpotter-dev",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node build/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
