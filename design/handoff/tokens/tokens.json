{
  "$description": "nathanpotter.dev tokens v1. Mirrors tokens.css; tokens.css wins if they differ.",
  "type": {
    "font": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "fs-1": "0.8125rem",
    "fs-2": "0.9375rem",
    "fs-3": "1.0625rem",
    "fs-4": "1.3125rem",
    "fs-5": "1.75rem",
    "fs-6": "clamp(2.25rem, 6vw, 3.5rem)",
    "fs-label": "0.6875rem",
    "lh-body": "1.55"
  },
  "space": {
    "sp-1": "4px",
    "sp-2": "8px",
    "sp-3": "12px",
    "sp-4": "16px",
    "sp-5": "24px",
    "sp-6": "32px",
    "sp-7": "48px",
    "sp-8": "72px"
  },
  "radius": {
    "r-1": "4px",
    "r-2": "8px",
    "r-pill": "999px"
  },
  "layout": {
    "content-max": "1200px",
    "gutter": "var(--sp-5)",
    "rail-w": "220px",
    "tap": "44px"
  },
  "color": {
    "light": {
      "bg": "#F2F5F5",
      "surface": "#FFFFFF",
      "surface-2": "#E6ECEC",
      "raised": "#FFFFFF",
      "ink": "#151A1B",
      "ink-2": "#4A5557",
      "line": "#D2DBDB",
      "brand": "#0F6E73",
      "brand-ink": "#FFFFFF",
      "band": "#0F6E73",
      "band-ink": "#FFFFFF",
      "band-line": "rgba(255, 255, 255, .35)",
      "accent": "#7A0E1B",
      "accent-text": "#7A0E1B",
      "chip": "#E3EEEE",
      "cta-bg": "#FFFFFF",
      "cta-ink": "#0F6E73",
      "cta-sub": "#4A5557",
      "cta-dot": "#0F6E73",
      "cta-dot-ink": "#FFFFFF"
    },
    "dark": {
      "bg": "#0D1213",
      "surface": "#151C1E",
      "surface-2": "#1D2628",
      "raised": "#212B2D",
      "ink": "#E9EFEF",
      "ink-2": "#A3B1B3",
      "line": "#2F3B3D",
      "brand": "#6CCBD0",
      "brand-ink": "#071113",
      "band": "#0B2F32",
      "band-ink": "#EAF5F5",
      "band-line": "rgba(234, 245, 245, .22)",
      "accent": "#B8344A",
      "accent-text": "#E9EFEF",
      "chip": "#1F3335",
      "cta-bg": "#6CCBD0",
      "cta-ink": "#071113",
      "cta-sub": "#14373A",
      "cta-dot": "#071113",
      "cta-dot-ink": "#6CCBD0"
    }
  },
  "shadow": {
    "light": {
      "shadow-1": "0 1px 2px rgba(10, 30, 32, .08), 0 1px 1px rgba(10, 30, 32, .04)",
      "shadow-2": "0 8px 24px rgba(10, 30, 32, .12)"
    },
    "dark": {
      "shadow-1": "0 0 0 1px rgba(255, 255, 255, .02), 0 1px 2px rgba(0, 0, 0, .5)",
      "shadow-2": "0 0 0 1px rgba(255, 255, 255, .04), 0 12px 32px rgba(0, 0, 0, .55)"
    }
  },
  "other": {
    "dim": ".28",
    "admin-bg": "#151A1B",
    "admin-ink": "#E9EFEF"
  },
  "usage": {
    "bg": "Page background",
    "surface": "Cards, header, footer on sub-pages",
    "surface-2": "Wells, current nav item",
    "raised": "Menus and popovers",
    "ink": "Body text, role-header rule",
    "ink-2": "Secondary text, meta",
    "line": "Borders, dividers",
    "brand": "Primary: metrics, links, primary buttons, selected chips",
    "brand-ink": "Text on brand fills",
    "band": "Hero band and homepage footer",
    "band-ink": "Text on band",
    "accent": "Secondary FILL only: title rule, admin-bar edge",
    "accent-text": "Secondary TEXT: job titles, skill group headings, AI step numbers, Gap label, link hover",
    "chip": "Tags, skills, statuses",
    "cta-*": "The fit CTA card on the band"
  }
}