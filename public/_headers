# Response headers for Cloudflare static assets. https://developers.cloudflare.com/workers/static-assets/headers/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Scripts only from this site, plus the inline theme setter by hash (tests/csp.test.mjs keeps the hash in sync) and
  # Cloudflare Turnstile for the job-fit form and Cloudflare Web Analytics (injected by Cloudflare in production).
  # Inline style attributes are allowed; inline scripts are not.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BKosNcLyqyXhBKYnhxS0jHTlmvHtacWyoDzcklf5C2g=' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Keep workers.dev and preview URLs (e.g. <id>-nathanpotter-dev.potterjnathan.workers.dev)
# out of search results; the custom domain is canonical.
https://:host.potterjnathan.workers.dev/*
  X-Robots-Tag: noindex
