# Response headers for Cloudflare static assets. https://developers.cloudflare.com/workers/static-assets/headers/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Keep workers.dev and preview URLs out of search results; the custom domain is canonical.
https://*.workers.dev/*
  X-Robots-Tag: noindex
